      "axios@^0": "0.27.2",
      "undici@^5": "5.29.0",
      "undici@^6": "6.29.1",
      "undici@^7": "7.30.2",
      "tar@^6": "6.2.1",
      "tar@^7": "7.5.22",
      "tar-fs@^3": "3.1.3",
      "fast-uri@^3": "3.1.9",
      "js-yaml@^3": "3.15.2",
