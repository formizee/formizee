{
  "name": "formizee",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "prepare": "husky",
    "test": "turbo test",
    "lint": "turbo lint",
    "check": "turbo check",
    "format": "pnpm biome format --write .",
    "build": "turbo build --cache-dir=.turbo",
    "local": "pnpm --dir=tools/local local"
