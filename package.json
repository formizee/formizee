    "@commitlint/config-conventional": "19.8.1",
    "@formizee/tsconfig": "workspace:*",
    "commitlint": "19.8.1",
    "husky": "9.1.7",
    "turbo": "2.11.10",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.0.5",
  "pnpm": {
    "overrides": {
