{
  "name": "@formizee/ui",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./form": {
      "types": "./src/components/form/index.tsx",
      "import": "./dist/components/form/index.mjs",
      "require": "./dist/components/form/index.js"
    },
    "./sidebar": {
      "types": "./src/components/sidebar/index.tsx",
      "import": "./dist/components/sidebar/index.mjs",
      "require": "./dist/components/sidebar/index.js"
    },
    "./toaster": {
      "types": "./src/components/toast/toaster.tsx",
      "import": "./dist/components/toast/toaster.mjs",
      "require": "./dist/components/toast/toaster.js"
    },
    "./icons": {
      "types": "./src/icons/index.tsx",
      "import": "./dist/icons/index.mjs",
      "require": "./dist/icons/index.js"
    },
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsup",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' tsup --watch --onSuccess 'tsc -d; echo DTS \u26a1\ufe0f Build succeed'"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@formizee/tsconfig": "workspace:*",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.7.2"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-hook-form": ">=7.54.2"
  }
}
